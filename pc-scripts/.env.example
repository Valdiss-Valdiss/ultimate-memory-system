# .env.example для pc-scripts — скопировать в .env (рядом со скриптами), заполнить
# НИКОГДА не коммитить реальный .env.

# ── Telegram user-session (my.telegram.org → API development tools) ────────
API_ID=changeme
API_HASH=changeme
SESSION_NAME=vault_import

# ── LLM (резюме/OCR/описания) ─────────────────────────────────────────────
LLM_KEY=changeme
LLM_BASE_URL=https://api.example-llm-provider.com/v1
LLM_MODEL=chosen-model-name

# ── Транскрипты (опционально) ─────────────────────────────────────────────
YOUTUBE_API_KEY=changeme
TRANSCRIPTAPI_KEY=changeme
DEEPGRAM_API_KEY=changeme

# ── Пути ──────────────────────────────────────────────────────────────────
# (могут быть заданы и через переменные окружения системы:
#  MEMORY_VAULT_DIR, MEMORY_VPS_TARGET, MEMORY_SSH_KEY)
VAULT=C:\Users\<user>\Documents\Obsidian Vault
VPS_TARGET=user@CHANGE-ME-server-ip
SSH_KEY=C:\Users\<user>\.ssh\id_ed25519
