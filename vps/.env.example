# .env.example — скопировать в .env и заполнить. chmod 600 .env
# НИКОГДА не коммитить реальный .env.

# ── Telegram ─────────────────────────────────────────────────────────────
# Получить на my.telegram.org → API development tools (5 минут, бесплатно)
API_ID=changeme
API_HASH=changeme
# Токен бота от @BotFather
BOT_TOKEN=changeme

# ── CouchDB (синхронизация LiveSync) ─────────────────────────────────────
COUCHDB_USER=changeme
COUCHDB_PASSWORD=changeme          # длинный случайный пароль

# ── Qdrant (семантический поиск) ─────────────────────────────────────────
QDRANT_API_KEY=changeme

# ── LLM-провайдер (резюме/OCR/переводы) ──────────────────────────────────
# Формат: OpenAI-совместимый endpoint + ключ
# Ротация ключей: кандидаты перебираются автоматически (LLM_KEY_1 → LLM_KEY_2 → LLM_KEY).
# 401/403 (ключ истёк/отозван) → cooldown, 429 (окно лимита) → пауза; работа продолжается
# на следующем кандидате. Подробности — docs/runbooks/runbook-llm-keys.md
LLM_KEY_1=
LLM_KEY_2=
# Заголовок сессии для провайдера (обязателен у части OpenAI-совместимых endpoint'ов)
LLM_SESSION=memory-system-notes
LLM_BASE_URL=https://api.example-llm-provider.com/v1
LLM_KEY=changeme
LLM_MODEL=chosen-model-name

# ── Транскрипты YouTube (опционально) ────────────────────────────────────
# Основной источник — субтитры (бесплатно). Для роликов без субтитров:
YOUTUBE_API_KEY=changeme           # опционально
TRANSCRIPTAPI_KEY=changeme         # опционально (пакетный сервис)
DEEPGRAM_API_KEY=changeme          # опционально (аудио-транскрипция)

# ── Пути/каталоги (внутри контейнеров) ───────────────────────────────────
# Лимит загрузки документа (МБ) и таймаут скачивания (с) — для крупных книг/сканов
MAX_DOC_DOWNLOAD_MB=700
PDF_DOCLING_MAX_PAGES=40
MIRROR_DIR=/mirror
TG_STAGE_DIR=/staging
TG_CACHE_DIR=/cache
FOLDER_TITLE=Telegram

# ── Память для ИИ-агентов: memory-MCP + гибридный поиск (v0.2.0) ─────────
# Коллекции Qdrant: смысловая (индексатор пишет, MCP читает) и словесная (BM25).
QDRANT_COLLECTION=vault_main
QDRANT_BM25_COLLECTION=vault_bm25
# Расширение запроса и «обобщи»: OpenAI-совместимый /chat/completions.
# Ключи — НЕ здесь, а в файле vps/secrets/mcp-llm-key (по одному в строке, chmod 600).
EXPAND_URL=https://api.example-llm-provider.com/v1/chat/completions
EXPAND_MODELS=cheap-fast-model,fallback-model   # дешёвая быстрая модель (расширение запроса)
SUMMARY_MODEL=strong-reasoning-model            # сильная модель (обобщение по всем найденным)
# Ссылки «открыть в Obsidian»: имя хранилища и https-переходник (vps/caddy/obsidian-open.html)
OBSIDIAN_VAULT_NAME=Obsidian Vault
OBSIDIAN_BRIDGE=https://mcp.YOUR-DOMAIN/o?

# ── SSH-гигиена (netguard) ───────────────────────────────────────────────
# Публичный IP компьютера пользователя (whitelist: всегда пропускается).
# При смене IP провайдером — обновить и перезапустить netguard.
PC_WHITELIST_IP=1.2.3.4

# ── Запланировано (следующая версия): графовый слой neo4j ────────────────
# Раскомментировать при включении сервиса neo4j в docker-compose.yml
#NEO4J_PASSWORD=changeme

# ── Прочее ───────────────────────────────────────────────────────────────
TZ=Europe/Moscow
LANG=C.UTF-8
