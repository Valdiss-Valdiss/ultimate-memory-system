# .env.example — скопировать в .env и заполнить. chmod 600 .env
# НИКОГДА не коммитить реальный .env.

# ── Telegram ─────────────────────────────────────────────────────────────
# Получить на my.telegram.org → API development tools (5 минут, бесплатно)
API_ID=changeme
API_HASH=changeme
# Токен бота от @BotFather
BOT_TOKEN=changeme

# ── CouchDB (синхронизация LiveSync) ─────────────────────────────────────
COUCHDB_USER=changeme
COUCHDB_PASSWORD=changeme          # длинный случайный пароль

# ── Qdrant (семантический поиск) ─────────────────────────────────────────
QDRANT_API_KEY=changeme

# ── LLM-провайдер (резюме/OCR/переводы) ──────────────────────────────────
# Формат: OpenAI-совместимый endpoint + ключ
LLM_BASE_URL=https://api.example-llm-provider.com/v1
LLM_KEY=changeme
LLM_MODEL=chosen-model-name

# ── Транскрипты YouTube (опционально) ────────────────────────────────────
# Основной источник — субтитры (бесплатно). Для роликов без субтитров:
YOUTUBE_API_KEY=changeme           # опционально
TRANSCRIPTAPI_KEY=changeme         # опционально (пакетный сервис)
DEEPGRAM_API_KEY=changeme          # опционально (аудио-транскрипция)

# ── Пути/каталоги (внутри контейнеров) ───────────────────────────────────
MIRROR_DIR=/mirror
TG_STAGE_DIR=/staging
TG_CACHE_DIR=/cache
FOLDER_TITLE=Telegram

# ── SSH-гигиена (netguard) ───────────────────────────────────────────────
# Публичный IP компьютера пользователя (whitelist: всегда пропускается).
# При смене IP провайдером — обновить и перезапустить netguard.
PC_WHITELIST_IP=1.2.3.4

# ── Запланировано (следующая версия): графовый слой neo4j ────────────────
# Раскомментировать при включении сервиса neo4j в docker-compose.yml
#NEO4J_PASSWORD=changeme

# ── Прочее ───────────────────────────────────────────────────────────────
TZ=Europe/Moscow
LANG=C.UTF-8
